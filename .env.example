# LINE OA (Messaging API) — ตั้งค่าบนโฮสต์จริงด้วย ห้าม commit ค่าจริง
# หาได้ที่ https://developers.line.biz/console/ -> Provider -> Messaging API channel

# Basic settings -> Channel secret (ใช้ตรวจลายเซ็นของ webhook)
LINE_CHANNEL_SECRET=

# Messaging API -> Channel access token (long-lived) — ใช้ส่งข้อความ
LINE_CHANNEL_ACCESS_TOKEN=

# groupId ของกลุ่มปลายทาง
# หาได้โดยเชิญ LINE OA เข้ากลุ่ม แล้วบอทจะทักบอก groupId ให้เอง
# หรือพิมพ์ "groupid" ในกลุ่ม (ต้องตั้ง Webhook URL เป็น /api/line-webhook/ ก่อน)
LINE_GROUP_ID=
